# Contact form (src/app/api/contact/route.ts). Set these in Vercel → Settings → Environment Variables.

# A Resend API key with permission to send emails (https://resend.com/api-keys).
RESEND_API_KEY="re_..."

# Where contact form messages are delivered. Replies go to the visitor (Reply-To).
CONTACT_EMAIL="info@yakasista.com"

# Optional sender. Its domain must be verified in Resend. Defaults to website@yakasista.com.
# CONTACT_FROM="Yakasista website <website@yakasista.com>"
